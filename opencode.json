{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-builder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Builder, port 21434)",
      "options": { "baseURL": "http://localhost:21434/v1" },
      "models": {
        "qwen3-coder-next:latest": { "name": "Qwen3 Coder Next" }
      }
    },
    "ollama-reviewer": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Reviewer, port 11434)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.8:27b-bf16": { "name": "Qwen3.8 27B bf16 (vision)" }
      }
    }
  },
  "agent": {
    "builder": {
      "description": "Builder. Before doing anything, read AGENTS.md then agents/builder.md in full and follow it.",
      "mode": "primary",
      "model": "ollama-builder/qwen3-coder-next:latest",
      "tools": { "write": true, "edit": true, "bash": true },
      "permission": {
        "bash": {
          "*": "allow",
          "pip install*": "deny",
          "pip3 install*": "deny",
          "python -m pip install*": "deny",
          "python3 -m pip install*": "deny",
          "apt install*": "deny",
          "apt-get install*": "deny",
          "sudo apt install*": "deny",
          "sudo apt-get install*": "deny",
          "conda install*": "deny",
          "npm install*": "deny",
          "npm i *": "deny"
        }
      }
    },
    "reviewer": {
      "description": "Reviewer. Before doing anything, read AGENTS.md then agents/reviewer.md in full and follow it. Visual QA only — no code editing, no shell commands.",
      "mode": "primary",
      "model": "ollama-reviewer/qwen3.8:27b-bf16",
      "permission": {
        "edit": {
          "*": "deny",
          "PROJECT_STATUS.md": "allow",
          "stages/01-slam/outputs/**/review.md": "allow"
        },
        "bash": "deny"
      }
    }
  }
}
